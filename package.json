{
  "name": "forge-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:components": "tsx --test tests/components/*.test.ts",
    "test:unit": "tsx --test tests/security.test.ts tests/youtube.test.ts tests/pipeline.test.ts tests/auth_llm_storage.test.ts tests/storage_backup.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "test:live": "tsx --test tests/llm.live.test.ts",
    "test:load": "tsx scripts/loadtest.ts",
    "make-video": "tsx scripts/make-video.ts",
    "make-clip": "tsx scripts/make-clip.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint:tests": "tsc --noEmit -p tsconfig.tests.json",
    "backup": "tsx scripts/backup.ts",
    "data-migration": "tsx scripts/data-migration.ts",
    "db-backup": "tsx scripts/db-backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@google/genai": "^2.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.65.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
