# Copy this file to .env and fill in your keys. Never commit .env.

# Required: Anthropic API key, used to write the script/hook/title/hashtags.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required: Pexels API key (free), used to source stock video clips.
# Get one at https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional overrides:
# SCRIPT_MODEL=claude-sonnet-4-6
# TTS_VOICE=en-US-GuyNeural          # try: en-US-AriaNeural, en-GB-RyanNeural, etc.
# TTS_RATE=+0%
# MAX_DURATION_S=58
# CAPTION_FONT_SIZE=78
# MUSIC_PATH=./assets/music/background.mp3   # your own royalty-free track
# MUSIC_VOLUME=0.12
