# ---------- Required in production ----------
# HMAC secret for guest sessions (>= 32 random chars). Generate: openssl rand -hex 32
SESSION_SECRET=
NODE_ENV=production

# ---------- AI (optional: without it the app serves clearly-labelled template fallbacks) ----------
GEMINI_API_KEY=
# Comma-separated failover order. Verify these model ids against your Gemini account.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
LLM_TIMEOUT_MS=25000

# ---------- Stock footage (optional) ----------
PEXELS_API_KEY=

# ---------- Auth ----------
# Defaults to projectId in firebase-applet-config.json
FIREBASE_PROJECT_ID=
# Comma-separated Firebase UIDs with admin rights (can see/delete any project)
ADMIN_USER_IDS=

# ---------- Storage (Phase 2) ----------
# Production: managed PostgreSQL (multi-instance safe). TLS is required unless sslmode=disable is stated.
# Without DATABASE_URL, production refuses to start unless STORAGE_BACKEND=json (single instance) is explicit.
DATABASE_URL=
# postgres | json  (empty = postgres when DATABASE_URL is set, json otherwise; json is the dev default)
STORAGE_BACKEND=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_STARTUP_RETRIES=10
# Apply schema migrations at startup (advisory-locked; set false to run them as a separate release step)
DATABASE_MIGRATE_ON_START=true
# Migration-specific timeouts (R-14): a single migration statement may run this long (default 30 min), and DDL
# waits at most MIGRATION_LOCK_TIMEOUT_MS for a busy table instead of blocking live traffic. All pending migrations
# run in one transaction: any failure leaves the schema unchanged.
MIGRATION_STATEMENT_TIMEOUT_MS=1800000
MIGRATION_LOCK_TIMEOUT_MS=60000
# Render job heartbeat / stale threshold (a dead instance's jobs are failed after JOB_STALE_MS)
JOB_HEARTBEAT_MS=1000
JOB_STALE_MS=30000

# ---------- Off-site encrypted backups (backup job only: Dockerfile.backup / npm run db-backup) ----------
# BACKUP_TARGET=s3://bucket/prefix   S3_ENDPOINT= (R2/B2/MinIO/GCS interop)   S3_REGION=
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   (write-only credential for the backup bucket)
# BACKUP_AGE_RECIPIENTS=age1...      (PUBLIC keys only; the private key stays offline)
# BACKUP_AGE_IDENTITY_FILE=          (restore only, on the operator's machine)

# ---------- Health / diagnostics (R-12) ----------
# /api/health and /api/live: liveness only ({"status":"ok"}). /api/ready: cached readiness (READY_CACHE_MS).
# /api/health/details: diagnostics, only with "Authorization: Bearer <HEALTH_DETAILS_TOKEN>" (>= 32 chars) or an
# admin identity; 404 otherwise. Leave empty to allow admins only.
HEALTH_DETAILS_TOKEN=
READY_CACHE_MS=1000
# Per-IP, per-instance limit for the public probe/config endpoints (in memory; no database load)
PROBE_RATE_LIMIT_PER_MIN=600
# AI quota reservations never settled (crashed request) are refunded after this long (R-02)
AI_RESERVATION_TTL_MS=900000

# ---------- Server ----------
PORT=3000
DATA_DIR=./data
# REQUIRED in production. "none" when clients connect directly; the number of trusted proxy hops
# (e.g. 1 behind one load balancer); or proxy IPs/CIDRs. "true" is rejected (lets clients spoof their IP).
TRUST_PROXY=none
# Comma-separated allowed CORS origins. Empty in production = same-origin only.
ALLOWED_ORIGINS=
# Renders (ffmpeg processes) THIS INSTANCE runs at once. It is a per-instance limit, not a global one: the whole
# deployment can run (number of instances) x MAX_CONCURRENT_RENDERS renders at once (3 instances x 2 = 6). Size the
# fleet with that in mind; each instance also reserves memory per render (RENDER_MEMORY_RESERVE_MB below).
MAX_CONCURRENT_RENDERS=2
RENDER_TTL_HOURS=24

# ---------- Guest registration protection (Track A, R-03) ----------
# Cloudflare Turnstile, verified server-side. REQUIRED in production unless CAPTCHA_REQUIRED=false (not recommended:
# guest sign-up is then protected only by the budgets below). Outside production it is on when TURNSTILE_SECRET is set.
# The secret is sent only to Cloudflare's siteverify: never logged, never returned. Store it in a secret manager.
CAPTCHA_REQUIRED=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Hostnames the widget runs on (required in production), e.g. app.example.com,www.example.com
TURNSTILE_HOSTNAMES=
# siteverify timeout. When Cloudflare is slow or down, NEW guest sign-ups get 503 captcha_unavailable; existing
# sessions and signed-in users are never affected.
TURNSTILE_TIMEOUT_MS=3000
TURNSTILE_MAX_TOKEN_AGE_S=300
# Budgets for new guest sessions, shared by all instances. A device is the __Host-fs_dev cookie (random, HttpOnly).
# Owner-approved initial values (2026-11-03), loose enough for shared networks (offices, universities, carrier NAT).
# Review them against /api/health/details -> guestMints.networkRefusals; do not tighten them silently.
GUEST_MINT_PER_DEVICE_PER_DAY=3
GUEST_MINT_PER_IP_PER_HOUR=20
# Applies per IPv4 /24 and per IPv6 /48
GUEST_MINT_PER_SUBNET_PER_HOUR=100
# Soft threshold for all new guests per hour: when reached, an alert is logged and the per-IP and per-subnet budgets
# are halved for the rest of the hour. It never rejects a verified sign-up. (GUEST_MINT_PER_HOUR is its old name.)
GUEST_MINT_SOFT_PER_HOUR=1000
# Optional hard ceiling (new guests per hour, all instances). 0 = off. Set it to 10x the measured p99 hourly peak
# once 14 days of data exist (/api/health/details -> guestMints.series); see docs/PHASE2_5_TRACK_A.md.
GUEST_MINT_HARD_PER_HOUR=0

# ---------- Render queue (Track B, R-04) ----------
# Server renders need a signed-in account (guests get 403 sign_in_required). Every user gets the same queue:
# there are no paid priority tiers.
# Per user: at most RUNNING jobs rendering + QUEUED jobs waiting; more -> 429 user_queue_full + Retry-After.
RENDER_MAX_RUNNING_PER_USER=1
RENDER_MAX_QUEUED_PER_USER=3
# Jobs waiting across all users and instances; more -> 429 queue_full + Retry-After (load is refused, not buffered).
RENDER_QUEUE_MAX=200
# Wall-clock limit per render = FACTOR x video seconds, clamped to [MIN_S, MAX_S]. Timed-out renders fail, uncharged.
RENDER_TIMEOUT_FACTOR=3
RENDER_TIMEOUT_MIN_S=60
RENDER_TIMEOUT_MAX_S=600
# A job still waiting after this long fails as expired (uncharged).
RENDER_QUEUE_TTL_S=1800
# Claims per job: a job whose worker dies is requeued until it has used this many; then it fails (no endless loop).
# A graceful shutdown (deploy) hands its jobs back without counting the attempt.
RENDER_MAX_ATTEMPTS=2
# POST /api/render/video waits this long for its queued job, then answers 202 with the job id to poll (the job keeps
# running). Keep it BELOW the load balancer idle timeout: a cut connection looks like a client that left and cancels.
RENDER_SYNC_WAIT_S=50
IP_DAILY_AI_CAP=600

# ---------- Storage limits (abuse protection) ----------
PROJECT_MAX_KB=512
GUEST_MAX_PROJECTS=10
GUEST_MAX_STORAGE_MB=5
USER_MAX_PROJECTS=200
USER_MAX_STORAGE_MB=25
# All guests together; protects signed-in users from guest-account farming
GUEST_POOL_MAX_MB=512
STORE_MAX_TOTAL_MB=4096
MIN_FREE_DISK_MB=256
# Per-IP rate buckets are this multiple of the per-user limit
IP_RATE_MULTIPLIER=4
FREE_DAILY_AI_QUOTA=50
FREE_MONTHLY_RENDER_MINUTES=10

# ---------- Backups ----------
# Verified snapshots of all data stores. Default dir is on the SAME volume (DATA_DIR/backups):
# copy them off-host until PostgreSQL backups replace this (Phase 2).
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=28

# ---------- Billing ----------
# "disabled" (default): plan changes return 501. "demo": free plan switching for demos ONLY — never in production.
BILLING_MODE=disabled

# ---------- Request bodies, memory and slow clients (Track C, R-13) ----------
# Bodies are read only after authentication. Per-route JSON limits: whole-project routes use PROJECT_MAX_KB + 64 KB;
# pasted transcripts BODY_LIMIT_TRANSCRIPT_KB; voice-to-text helpers BODY_LIMIT_MEDIUM_KB; everything else
# BODY_LIMIT_DEFAULT_KB. Larger bodies get 413 before being read.
BODY_LIMIT_DEFAULT_KB=16
BODY_LIMIT_MEDIUM_KB=64
BODY_LIMIT_TRANSCRIPT_KB=1024
# At most BODY_CONCURRENCY bodies larger than LARGE_BODY_KB (or chunked) are in flight per instance; the excess gets
# 503 "busy" + Retry-After (backpressure instead of buffering). Worst case per instance ~ BODY_CONCURRENCY x route limit.
BODY_CONCURRENCY=16
LARGE_BODY_KB=64
# Memory guard: above this Node RSS, large-body and render requests get 503 "memory_pressure" and /api/ready reports
# not-ready (the load balancer drains the instance); recovers below 90 %.
# Unset = computed so the ffmpeg render processes (separate processes, NOT part of Node's RSS) still fit:
#   MEMORY_SOFT_LIMIT_MB = 0.8 x container memory - MAX_CONCURRENT_RENDERS x RENDER_MEMORY_RESERVE_MB
#   e.g. 1 GB container, 2 renders x 256 MB -> 307 MB for Node.
# Set explicitly = used as-is (the render reserve is NOT subtracted again). 0 disables the guard.
# A computed value below MEMORY_MIN_NODE_MB stops the server at startup with an explanation.
MEMORY_SOFT_LIMIT_MB=
# Container memory in MB when it cannot be read from the cgroup (unset: cgroup limit, else host memory).
MEMORY_CONTAINER_LIMIT_MB=
# Memory reserved per concurrent render (worst case measured: 169 MB for a 60 s 1080p render).
RENDER_MEMORY_RESERVE_MB=256
MEMORY_MIN_NODE_MB=192
# (MAX_CONCURRENT_RENDERS above also sizes the render reserve; it must be a whole number >= 1, otherwise the server
# refuses to start.)
MEMORY_SAMPLE_MS=1000
# Slow clients: time allowed to send the request headers, and the whole request (headers + body). Responses are not
# affected (long AI calls are fine).
HEADERS_TIMEOUT_MS=20000
REQUEST_TIMEOUT_MS=60000
