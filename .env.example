# ---------- Required in production ----------
# HMAC secret for guest sessions (>= 32 random chars). Generate: openssl rand -hex 32
SESSION_SECRET=
NODE_ENV=production

# ---------- AI (optional: without it the app serves clearly-labelled template fallbacks) ----------
GEMINI_API_KEY=
# Comma-separated failover order. Verify these model ids against your Gemini account.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
LLM_TIMEOUT_MS=25000

# ---------- Stock footage (optional) ----------
PEXELS_API_KEY=

# ---------- Auth ----------
# Defaults to projectId in firebase-applet-config.json
FIREBASE_PROJECT_ID=
# Comma-separated Firebase UIDs with admin rights (can see/delete any project)
ADMIN_USER_IDS=

# ---------- Storage (Phase 2) ----------
# Production: managed PostgreSQL (multi-instance safe). TLS is required unless sslmode=disable is stated.
# Without DATABASE_URL, production refuses to start unless STORAGE_BACKEND=json (single instance) is explicit.
DATABASE_URL=
# postgres | json  (empty = postgres when DATABASE_URL is set, json otherwise; json is the dev default)
STORAGE_BACKEND=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_STARTUP_RETRIES=10
# Apply schema migrations at startup (advisory-locked; set false to run them as a separate release step)
DATABASE_MIGRATE_ON_START=true
# Migration-specific timeouts (R-14): a single migration statement may run this long (default 30 min), and DDL
# waits at most MIGRATION_LOCK_TIMEOUT_MS for a busy table instead of blocking live traffic. All pending migrations
# run in one transaction: any failure leaves the schema unchanged.
MIGRATION_STATEMENT_TIMEOUT_MS=1800000
MIGRATION_LOCK_TIMEOUT_MS=60000
# Render job heartbeat / stale threshold (a dead instance's jobs are failed after JOB_STALE_MS)
JOB_HEARTBEAT_MS=1000
JOB_STALE_MS=30000

# ---------- Off-site encrypted backups (backup job only: Dockerfile.backup / npm run db-backup) ----------
# BACKUP_TARGET=s3://bucket/prefix   S3_ENDPOINT= (R2/B2/MinIO/GCS interop)   S3_REGION=
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   (write-only credential for the backup bucket)
# BACKUP_AGE_RECIPIENTS=age1...      (PUBLIC keys only; the private key stays offline)
# BACKUP_AGE_IDENTITY_FILE=          (restore only, on the operator's machine)

# ---------- Health / diagnostics (R-12) ----------
# /api/health and /api/live: liveness only ({"status":"ok"}). /api/ready: cached readiness (READY_CACHE_MS).
# /api/health/details: diagnostics, only with "Authorization: Bearer <HEALTH_DETAILS_TOKEN>" (>= 32 chars) or an
# admin identity; 404 otherwise. Leave empty to allow admins only.
HEALTH_DETAILS_TOKEN=
READY_CACHE_MS=1000
# Per-IP, per-instance limit for the public probe/config endpoints (in memory; no database load)
PROBE_RATE_LIMIT_PER_MIN=600
# AI quota reservations never settled (crashed request) are refunded after this long (R-02)
AI_RESERVATION_TTL_MS=900000

# ---------- Server ----------
PORT=3000
DATA_DIR=./data
# REQUIRED in production. "none" when clients connect directly; the number of trusted proxy hops
# (e.g. 1 behind one load balancer); or proxy IPs/CIDRs. "true" is rejected (lets clients spoof their IP).
TRUST_PROXY=none
# Comma-separated allowed CORS origins. Empty in production = same-origin only.
ALLOWED_ORIGINS=
MAX_CONCURRENT_RENDERS=2
RENDER_TTL_HOURS=24
IP_DAILY_AI_CAP=600

# ---------- Storage limits (abuse protection) ----------
PROJECT_MAX_KB=512
GUEST_MAX_PROJECTS=10
GUEST_MAX_STORAGE_MB=5
USER_MAX_PROJECTS=200
USER_MAX_STORAGE_MB=25
# All guests together; protects signed-in users from guest-account farming
GUEST_POOL_MAX_MB=512
STORE_MAX_TOTAL_MB=4096
MIN_FREE_DISK_MB=256
# Global cap on new guest sessions per hour (in addition to 10/min per IP)
GUEST_MINT_PER_HOUR=1000
# Per-IP rate buckets are this multiple of the per-user limit
IP_RATE_MULTIPLIER=4
FREE_DAILY_AI_QUOTA=50
FREE_MONTHLY_RENDER_MINUTES=10

# ---------- Backups ----------
# Verified snapshots of all data stores. Default dir is on the SAME volume (DATA_DIR/backups):
# copy them off-host until PostgreSQL backups replace this (Phase 2).
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=28

# ---------- Billing ----------
# "disabled" (default): plan changes return 501. "demo": free plan switching for demos ONLY — never in production.
BILLING_MODE=disabled

# ---------- Request bodies, memory and slow clients (Track C, R-13) ----------
# Bodies are read only after authentication. Per-route JSON limits: whole-project routes use PROJECT_MAX_KB + 64 KB;
# pasted transcripts BODY_LIMIT_TRANSCRIPT_KB; voice-to-text helpers BODY_LIMIT_MEDIUM_KB; everything else
# BODY_LIMIT_DEFAULT_KB. Larger bodies get 413 before being read.
BODY_LIMIT_DEFAULT_KB=16
BODY_LIMIT_MEDIUM_KB=64
BODY_LIMIT_TRANSCRIPT_KB=1024
# At most BODY_CONCURRENCY bodies larger than LARGE_BODY_KB (or chunked) are in flight per instance; the excess gets
# 503 "busy" + Retry-After (backpressure instead of buffering). Worst case per instance ~ BODY_CONCURRENCY x route limit.
BODY_CONCURRENCY=16
LARGE_BODY_KB=64
# Memory guard: above this RSS, large-body and render requests get 503 "memory_pressure" and /api/ready reports
# not-ready (the load balancer drains the instance); recovers below 90 %. Unset = 80 % of the container (cgroup)
# memory limit, else of host memory. 0 disables.
MEMORY_SOFT_LIMIT_MB=
MEMORY_SAMPLE_MS=1000
# Slow clients: time allowed to send the request headers, and the whole request (headers + body). Responses are not
# affected (long AI calls are fine).
HEADERS_TIMEOUT_MS=20000
REQUEST_TIMEOUT_MS=60000
