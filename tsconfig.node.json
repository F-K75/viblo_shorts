{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/backup.ts",
    "scripts/data-migration.ts",
    "scripts/db-backup.ts",
    "vite.config.ts",
    "server.ts",
    "server/**/*.ts"
  ]
}
